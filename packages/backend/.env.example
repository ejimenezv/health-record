# Application
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://healthrecord:healthrecord_dev@localhost:5432/healthrecord"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# OpenAI
OPENAI_API_KEY="your-openai-api-key"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Logging
LOG_LEVEL="debug"

# Python AI Service (Prompts 14-25)
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_WS_URL="ws://localhost:8000"
# Must match the AI service's JWT_SECRET_KEY exactly (HS256, claim `sub`).
# The Node backend mints a short-lived service token per request; there is no
# /auth/token endpoint to log into.
AI_SERVICE_JWT_SECRET="change-this-to-a-secure-secret-key-min-32-chars"
# Subject placed in the JWT `sub` claim when no per-user subject is supplied.
AI_SERVICE_SUBJECT="node-backend"
